{
  "name": "woodpecker",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./*",
    "#src/*": "./src/*",
    "#worker/*": "./worker/*"
  },
  "scripts": {
    "prepare": "pnpm run lexicon:build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "pnpm run --aggregate-output '/^(oxlint|oxfmt|depcruise|steiger|typecheck)$/'",
    "fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "oxfmt": "oxfmt --check",
    "oxfmt:fix": "oxfmt",
    "depcruise": "depcruise src",
    "depcruise:graph": "depcruise src --include-only \"^src\" --output-type dot | dot -T svg > dependency-graph.svg",
    "steiger": "steiger src",
    "steiger:watch": "steiger src --watch",
    "typecheck": "tsc -b --noEmit",
    "vitest": "vitest run",
    "vitest:dev": "vitest",
    "playwright": "playwright test",
    "playwright:dev": "playwright test --ui",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lexicon:install": "lex install",
    "lexicon:build": "lex build --clear --out src/shared/api/lexicons --index-file"
  },
  "dependencies": {
    "@atproto/api": "^0.20.36",
    "@atproto/lex": "^0.3.2",
    "@atproto/oauth-client-browser": "^0.5.1",
    "hono": "^4.12.33",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "steiger": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.118.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    }
  }
}
