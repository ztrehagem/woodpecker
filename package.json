{
  "name": "woodpecker",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./*",
    "#src/*": "./src/*",
    "#worker/*": "./worker/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "prepare": "pnpm run lexicon:ci && pnpm run lexicon:build",
    "dev": "vite",
    "build": "vite build",
    "lint": "pnpm run --aggregate-output '/^(oxlint|oxfmt|depcruise|steiger|typecheck)$/'",
    "fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "oxfmt": "oxfmt --check",
    "oxfmt:fix": "oxfmt",
    "depcruise": "depcruise src",
    "depcruise:graph": "depcruise src --include-only \"^src\" --output-type dot | dot -T svg > dependency-graph.svg",
    "steiger": "steiger src",
    "steiger:watch": "steiger src --watch",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm run vitest && pnpm run playwright",
    "vitest": "vitest run",
    "vitest:dev": "vitest",
    "playwright": "playwright test",
    "playwright:dev": "playwright test --ui",
    "wrangler:typegen": "wrangler types",
    "lexicon:add": "lex install",
    "lexicon:ci": "lex install --ci",
    "lexicon:update": "lex install --update --save",
    "lexicon:build": "lex build --clear --out src/shared/api/lexicons --index-file"
  },
  "dependencies": {
    "@atproto/api": "^0.29.6",
    "@atproto/lex": "^0.4.4",
    "@atproto/oauth-client-browser": "^0.5.11",
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@feature-sliced/steiger-plugin": "^0.8.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "steiger": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.155.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "warn"
    }
  }
}
